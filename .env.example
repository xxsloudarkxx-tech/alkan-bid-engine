# ALKAN Bid Engine v4 — Environment Configuration Example (copy to .env or configure in PowerShell)
# NEVER commit real API keys, client secrets, or OAuth tokens.

# ── AI Estimator / Review Provider ──────────────────────────────────────────
ANTHROPIC_API_KEY=
BIDKIT_CLAUDE_MODEL=claude-fable-5-2
BIDKIT_API_KEY=
BIDKIT_API_BASE=
BIDKIT_MODEL=
BIDKIT_AUDIT_MODEL=
BIDKIT_VISION=0

# ── ALKAN Workflow Studio Integration ───────────────────────────────────────
ALKAN_STUDIO_URL=
ALKAN_STUDIO_HMAC_SECRET=

# ── QuickBooks Online OAuth 2.0 / Accounting Integration ────────────────────
QUICKBOOKS_ENV=sandbox
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
QUICKBOOKS_REALM_ID=
QUICKBOOKS_ACCESS_TOKEN=
QUICKBOOKS_REFRESH_TOKEN=

# ── Contractor Superbot / Runtime Controls ──────────────────────────────────
BIDKIT_DEFAULT_ORG=default
BIDKIT_STRICT_RBAC=0
