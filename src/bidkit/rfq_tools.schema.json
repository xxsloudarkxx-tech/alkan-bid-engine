  {
    "name": "contar_espaciamiento",
    "description": "Cuenta postes por tramos abiertos y espaciamiento máximo documentado. Indica extremos compartidos reales y terminales adicionales. Conteo gráfico opcional permite detectar discrepancias.",
    "input_schema": {
      "type": "object",
      "properties": {
        "longitudes_tramos": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^\\d+(?:\\.\\d+)?$"
              }
            ]
          },
          "minItems": 1
        },
        "espaciamiento_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^\\d+(?:\\.\\d+)?$"
            }
          ]
        },
        "fuente": {
          "type": "string",
          "minLength": 1
        },
        "extremos_compartidos": {
          "type": "integer",
          "minimum": 0
        },
        "terminales_extra": {
          "type": "integer",
          "minimum": 0
        },
        "conteo_grafico": {
          "type": "integer",
          "minimum": 0
        },
        "unidad": {
          "type": "string"
        }
      },
      "required": [
        "longitudes_tramos",
        "espaciamiento_max",
        "fuente"
      ]
    }
  },
  {
    "name": "contar_por_espaciamiento",
    "description": "Cuenta un tramo: ceil(longitud/espaciamiento)+1 con extremos, -1 sin extremos. Sin portones ni huecos.",
    "input_schema": {
      "type": "object",
      "properties": {
        "longitud": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^\\d+(?:\\.\\d+)?$"
            }
          ]
        },
        "espaciamiento": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^\\d+(?:\\.\\d+)?$"
            }
          ]
        },
        "fuente": {
          "type": "string",
          "minLength": 1
        },
        "extremos": {
          "type": "boolean"
        }
      },
      "required": [
        "longitud",
        "espaciamiento",
        "fuente"
      ]
    }
  }
]