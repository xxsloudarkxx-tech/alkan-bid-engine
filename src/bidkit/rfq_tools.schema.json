  {
    "name": "calcular_takeoff",
    "input_schema": {
      "type": "object",
      "properties": {
        "concepto": {
          "type": "string"
        },
        "formula": {
          "type": "string",
          "description": "Expresión con variables nombradas"
        },
        "variables": {
          "type": "object"
        },
        "unidad": {
          "type": "string"
        },
        "desperdicio_pct": {
          "type": "number"
        },
        "fuente": {
          "type": "string",
          "description": "Hoja/sección de origen"
        },
        "tamano_empaque": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^\\d+(?:\\.\\d+)?$"
            }
          ]
        },
        "unidad_compra": {
          "type": "string"
        },
        "redondeo": {
          "type": "string",
          "enum": [
            "arriba",
            "ninguno"
          ]
        },
        "multiplo_compra": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^\\d+(?:\\.\\d+)?$"
            }
          ]
        }
      },
      "required": [
        "concepto",
        "formula",
        "variables",
        "unidad",
        "fuente"
      ]
    },
    "description": "Calcula cantidad con fórmula auditable y desperdicio. Para rollos, bolsas o piezas usa tamano_empaque (en unidad base) y unidad_compra: redondea arriba. Sin empaque conserva cantidades continuas."
  },
