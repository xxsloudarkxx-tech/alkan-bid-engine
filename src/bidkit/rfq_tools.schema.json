  {
    "name": "calibrar_escala",
    "description": "Calibra una página PDF completa con dos puntos en píxeles de la rasterización a DPI indicado y una distancia real de cota escrita. Devuelve calibración con hash del PDF y escala. No adivines puntos, cota ni incertidumbre.",
    "input_schema": {
      "type": "object",
      "properties": {
        "ruta": {
          "type": "string"
        },
        "pagina": {
          "type": "integer",
          "minimum": 1
        },
        "puntos_referencia": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 2,
          "maxItems": 2
        },
        "distancia_real": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^\\d+(?:\\.\\d+)?$"
            }
          ]
        },
        "unidad_real": {
          "type": "string"
        },
        "fuente": {
          "type": "string",
          "minLength": 1
        },
        "dpi": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "incertidumbre_pct": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^\\d+(?:\\.\\d+)?$"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ruta",
        "pagina",
        "puntos_referencia",
        "distancia_real",
        "unidad_real",
        "fuente"
      ]
    }
  },
  {
    "name": "medir_plano",
    "description": "Mide longitud de una polilínea o área de un polígono simple con calibración trazable del PDF. Puntos en píxeles de imagen completa, sin recortar. No usar factor inventado.",
    "input_schema": {
      "type": "object",
      "properties": {
        "calibracion": {
          "type": "object"
        },
        "puntos": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 2,
          "maxItems": 10000
        },
        "tipo": {
          "type": "string",
          "enum": [
            "longitud",
            "area"
          ]
        },
        "fuente": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "calibracion",
        "puntos",
        "tipo",
        "fuente"
      ]
    }
  },
